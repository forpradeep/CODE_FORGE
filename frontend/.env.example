# Local Vite dev server. Leave unset in the Docker image so the app calls /api
# on the same origin and nginx proxies it to the backend.
VITE_API_BASE_URL=http://localhost:3000

# Split hosting (Vercel frontend + Render API). Cookies then need
# COOKIE_SAMESITE=none and COOKIE_SECURE=true on the backend.
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
