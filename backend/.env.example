# Server
PORT=3000
NODE_ENV=development
# Comma-separated browser origins that may call the API with cookies
CLIENT_URL=http://localhost:5173
TRUST_PROXY=0

# Database
DB_CONNECT_STRING=mongodb://127.0.0.1:27017/codeforge

# Auth. In production this must be a unique secret of at least 32 characters.
JWT_KEY=replace-with-a-random-string-at-least-32-characters
# SESSION_MS=43200000
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# Redis. Use REDIS_URL for a hosted instance, or host/port for local Redis.
# REDIS_URL=redis://default:password@host:port
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASS=
# REDIS_USERNAME=default

# Code execution (Judge0 via RapidAPI)
JUDGE0_KEY=your_judge0_rapidapi_key_here

# AI assistance (Google Gemini)
GEMINI_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Cloudinary video uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Demo accounts. Refused when NODE_ENV=production unless ALLOW_SEED=true.
# SEED_PASSWORD=Password@123
# ALLOW_SEED=false
